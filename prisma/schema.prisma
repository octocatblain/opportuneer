generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Track {
  JOB // apply as an employee
  PITCH // pitch Red Star Standard
}

enum Stage {
  FOUND
  SHORTLISTED
  DRAFTED
  SENT
  REPLIED
  INTERVIEW // interview (job) or meeting/proposal (pitch)
  WON
  LOST
  ARCHIVED
}

enum Role {
  SUPERUSER // seeded owner: sees and manages every user's content
  USER // sees only their own content
}

enum DocKind {
  CV
  COVER_LETTER
  EMAIL
  PITCH_EMAIL
  PROPOSAL
  FOLLOW_UP
}

model Company {
  id              String        @id @default(cuid())
  userId          String
  user            User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  name            String
  website         String?
  industry        String? // key from config/industries
  location        String?
  employees       Int? // estimated headcount
  revenueNote     String? // free-text revenue/budget signal
  aiMaturity      Int? // 1 = no tech/AI at all ... 5 = mature AI team
  growthSignals   String? // expansion, funding, tenders, hiring
  recurringNeeds  String? // ongoing work: maintenance, automation, support
  contactName     String?
  contactEmail    String?
  contactRole     String?
  notes           String?
  research        String? // AI-written research summary
  score           Int? // 0-100 company fit
  scoreBreakdown  Json?
  recommendation  Track? // primary route the app suggests
  recommendBoth   Boolean       @default(false)
  recommendReason String?
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  opportunities   Opportunity[]

  @@unique([userId, name])
  @@index([userId])
}

model Opportunity {
  id           String     @id @default(cuid())
  userId       String
  user         User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  track        Track
  title        String // job title, or pitch headline
  companyId    String?
  company      Company?   @relation(fields: [companyId], references: [id], onDelete: SetNull)
  source       String // remotive, arbeitnow, manual, linkedin-paste, research...
  sourceId     String? // id at the source, for de-duplication
  url          String?
  description  String?
  location     String?
  remote       Boolean    @default(false)
  verified     Boolean    @default(false) // job board marked the employer/post as verified
  employment   String? // full-time, contract, part-time
  salaryMin    Int?
  salaryMax    Int?
  currency     String? // KES, USD, EUR...
  salaryPeriod String? // month, year
  fitScore     Int? // 0-100
  fitBreakdown Json?
  stage        Stage      @default(FOUND)
  followUpAt   DateTime?
  sentAt       DateTime?
  postedAt     DateTime?
  createdAt    DateTime   @default(now())
  updatedAt    DateTime   @updatedAt
  documents    Document[]
  activities   Activity[]

  @@unique([userId, source, sourceId])
  @@index([userId])
  @@index([stage])
  @@index([fitScore])
}

model Document {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  kind          DocKind
  subject       String? // for emails
  content       String // markdown/plain text or HTML (CV)
  pdfPath       String? // relative to /storage
  provider      String? // which AI wrote it
  gmailDraftId  String?
  createdAt     DateTime    @default(now())
}

model Activity {
  id            String      @id @default(cuid())
  opportunityId String
  opportunity   Opportunity @relation(fields: [opportunityId], references: [id], onDelete: Cascade)
  type          String // stage_change, generated, gmail_draft, note, scan
  message       String
  createdAt     DateTime    @default(now())
}

model Setting {
  key       String   @id
  value     Json
  updatedAt DateTime @updatedAt
}

model User {
  id            String           @id @default(cuid())
  email         String           @unique // stored lowercase
  name          String?
  passwordHash  String? // scrypt; null for Google-only accounts
  googleId      String?          @unique
  role          Role             @default(USER)
  trackAccess   TrackAccess      @default(BOTH) // which tracks this account may use; gates screens and caps
  cohort        String? // "A" | "B" for pilot users, copied from the waitlist entry when the invite is accepted
  freeUntil     DateTime? // free access ends here (copied from the waitlist entry)
  foundingUntil DateTime? // founding-member pricing ends here (copied from the waitlist entry)
  createdAt     DateTime         @default(now())
  lastLoginAt   DateTime?
  sessions      Session[]
  companies     Company[]
  opportunities Opportunity[]
  invitesSent   Invite[]         @relation("InvitedBy")
  invite        Invite?          @relation("AcceptedBy")
  credits       CreditLedger[]
  feedback      Feedback[]
  events        AnalyticsEvent[]
  kyc           UserProfile?
}

/// Which tracks an account may use. Opportunity.track stays JOB | PITCH: a single item is one or the other.
enum TrackAccess {
  JOB
  PITCH
  BOTH
}

enum InviteStatus {
  PENDING
  ACCEPTED
  REVOKED
}

model Invite {
  id              String         @id @default(cuid())
  email           String // stored lowercase
  trackAccess     TrackAccess    @default(BOTH)
  status          InviteStatus   @default(PENDING)
  waitlistEntryId String?        @unique
  waitlistEntry   WaitlistEntry? @relation(fields: [waitlistEntryId], references: [id], onDelete: SetNull)
  invitedById     String
  invitedBy       User           @relation("InvitedBy", fields: [invitedById], references: [id], onDelete: Cascade)
  acceptedById    String?        @unique
  acceptedBy      User?          @relation("AcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  createdAt       DateTime       @default(now())
  acceptedAt      DateTime?
  tokenHash       String?        @unique // SHA-256 of the secret in the invite link; the link itself is shown once
  expiresAt       DateTime?

  @@index([email, status])
}

/// One row per credit-consuming action; balance = sum(credits).
model CreditLedger {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  action          String // e.g. cv_generated, pitch_written, research, grant, purchase
  credits         Int // negative = spent, positive = granted
  costEstimateKes Decimal  @default(0) @db.Decimal(12, 2) // estimated provider cost of the action
  createdAt       DateTime @default(now())

  @@index([userId, createdAt])
}

model Feedback {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  kind      String   @default("general") // general | bug | idea
  rating    Int? // 1-5
  message   String
  page      String?
  createdAt DateTime @default(now())

  @@index([userId, createdAt])
}

model AnalyticsEvent {
  id         String   @id @default(cuid())
  userId     String? // null for anonymous (signed-out) events
  user       User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  name       String
  properties Json?
  createdAt  DateTime @default(now())

  @@index([name, createdAt])
  @@index([userId, createdAt])
}

model Session {
  id         String   @id @default(cuid())
  tokenHash  String   @unique // sha256 of the cookie token; the raw token is never stored
  userId     String
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  method     String // password | google
  userAgent  String?
  ip         String?
  createdAt  DateTime @default(now())
  lastSeenAt DateTime @default(now())
  expiresAt  DateTime

  @@index([userId])
  @@index([expiresAt])
}

enum WaitlistTrack {
  SEEKER
  PITCH
  BOTH
}

enum WaitlistStatus {
  WAITING
  INVITED
  ACTIVE
  DECLINED
}

/// PILOT: one of the 30 pilot places (first 10 = cohort A, next 20 = cohort B), assigned automatically at signup.
/// PUBLIC: waitlist for the public launch, unlimited, invited in batches later.
enum WaitlistPhase {
  PILOT
  PUBLIC
}

model WaitlistEntry {
  id               String         @id @default(cuid())
  seq              Int            @unique @default(autoincrement()) // join order
  email            String         @unique // stored lowercase
  name             String?
  trackInterest    WaitlistTrack
  roleType         String? // job_seeker | freelancer_agency | recruiter_coach | other
  occupation       String? // optional, job seekers
  industry         String? // optional, key from config industries (pitch track)
  country          String?
  source           String? // ?src= tag from the link or post
  consentMarketing Boolean        @default(false)
  consentAt        DateTime
  phase            WaitlistPhase
  cohort           String? // "A" | "B" for pilot entries, null for public
  status           WaitlistStatus @default(WAITING)
  invitedAt        DateTime?
  freeUntil        DateTime? // copied to User when the invite is accepted
  foundingUntil    DateTime? // copied to User when the invite is accepted
  createdAt        DateTime       @default(now())
  invite           Invite?

  @@index([phase, cohort])
  @@index([status])
}

/// KYC / search profile, one row per user. Each section is saved separately and only overrides the app defaults once its *DoneAt is set.
model UserProfile {
  userId          String    @id
  user            User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  basics          Json? // name, phone, location, notice period, links
  jobPrefs        Json? // job track: titles, industries, pay floors, locations
  pitchPrefs      Json? // pitch track: the user's own agency, offer/packages, client floor
  basicsDoneAt    DateTime?
  jobDoneAt       DateTime?
  pitchDoneAt     DateTime?
  resumeName      String?
  resumePath      String? // relative to storage/
  resumeMime      String?
  resumeText      String?
  resumeUpdatedAt DateTime?
  updatedAt       DateTime  @updatedAt
}
