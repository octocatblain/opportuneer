# --- Database (local PostgreSQL 18 on this laptop) ---
# Replace YOUR_PASSWORD with your postgres user's password.
DATABASE_URL="postgresql://postgres:YOUR_PASSWORD@localhost:5432/opportuneer?schema=public"

# --- AI providers (tried in this order; the first that works is used) ---
# Paid keys: console.anthropic.com (Settings > API Keys) and platform.openai.com (API keys). Prepaid credit; set a spend limit in each console.
# Note: Gemini's free tier may use prompts (incl. CV details) to improve Google's products. Keep it last once you have a paid key.
AI_PROVIDERS="claude,openai,gemini"
ANTHROPIC_API_KEY=""
ANTHROPIC_MODEL="claude-sonnet-5-5"
# Optional: a stronger model just for CVs, cover letters, pitches and proposals (e.g. "claude-opus-5-5"). Empty = use ANTHROPIC_MODEL.
ANTHROPIC_PREMIUM_MODEL=""
OPENAI_API_KEY=""
OPENAI_MODEL="gpt-5"
# Max Claude + OpenAI calls per day (shared by the app and the daily scan). Counts live in storage/ai-usage.json.
AI_DAILY_PAID_CALL_LIMIT="60"

# --- Gmail (drafts only) ---
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""
GOOGLE_REDIRECT_URI="http://localhost:3000/api/auth/callback/google"
GMAIL_ACCOUNT="you@gmail.com"

# Optional: path to Chrome/Edge for PDF rendering (auto-detected otherwise)
# CHROME_PATH="C:/Program Files (x86)/Microsoft/Edge/Application/msedge.exe"

# Gemini (free key from https://aistudio.google.com/apikey)
GEMINI_API_KEY=""
# Tried left to right; the free tier often 503s on the bigger models, so lite is the last resort.
GEMINI_MODEL="gemini-flash-latest,gemini-3.8-flash,gemini-flash-lite-latest"

# Set to 1 to stop "npm run dev"/"npm start" from running a background scan on startup.
SKIP_STARTUP_SCAN="0"
