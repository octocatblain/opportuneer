{
  "name": "opportuneer",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3000",
    "build": "next build",
    "start": "next start -p 3000",
    "lint": "eslint",
    "scan": "tsx scripts/scan.ts",
    "backup": "tsx --env-file=.env scripts/backup.ts",
    "prune": "tsx --env-file=.env scripts/prune.ts",
    "check:secrets": "tsx scripts/check-secrets.ts",
    "test": "tsx --env-file=.env scripts/test.ts",
    "db:setup": "prisma migrate deploy && npm run db:seed",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx --env-file=.env prisma/seed.ts",
    "postinstall": "prisma generate"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.11.0",
    "@google/genai": "^3.6.1",
    "@prisma/client": "^6.19.3",
    "cheerio": "^1.2.0",
    "gsap": "^3.15.1",
    "lenis": "^1.3.27",
    "mammoth": "^1.13.0",
    "motion": "^14.14.0",
    "next": "^15.5.29",
    "nodemailer": "^10.6.1",
    "openai": "^7.62.0",
    "pdf-lib": "^1.17.1",
    "puppeteer-core": "^25.18.1",
    "react": "19.1.0",
    "react-dom": "19.1.0",
    "sweetalert2": "^11.26.25",
    "unpdf": "^2.2.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^15.5.29",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5"
  }
}
